# Generate actual local values with scripts/bootstrap.py. Never commit .env.
PUBLIC_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/clouddroid.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_WITH_BOOTSTRAP
ENCRYPTION_KEY=GENERATE_WITH_BOOTSTRAP
COOKIE_SECURE=false
RUNTIME_ENABLED=false
ANDROID_IMAGE=clouddroid-android:local
MAX_ACTIVE_SESSIONS=1
MAX_PROFILES=12
SESSION_HOURS=8
STREAM_FPS=5
# Optional TURN, shared-secret ephemeral credentials (coturn use-auth-secret).
TURN_URL=
TURN_SECRET=
# PostgreSQL deployment only; generate a strong password.
POSTGRES_PASSWORD=GENERATE_WITH_BOOTSTRAP
# Production Caddy hostname; PUBLIC_URL must use https:// and COOKIE_SECURE=true.
DOMAIN=localhost
